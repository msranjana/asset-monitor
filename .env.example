# Copy to .env and edit. At least one of RTSP_URL or VIDEO_PATH is required.

# Live camera (rtsp://...)
RTSP_URL=

# Local test clip; when set, overrides RTSP_URL (e.g. videos/sample.mp4)
VIDEO_PATH=videos/t4.mp4

LOG_FILE_PATH=logs/events.log
RECONNECT_DELAY=5

SMOKE_FIRE_MODEL_PATH=models/fire_smoke_yolov8n.pt

# Email alerts — leave empty to skip SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
ALERT_TO_EMAILS=
